{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/functions/v1/app/:path*",
      "destination": "/api/functions/v1/app/dispatch?_p=:path*"
    },
    { "source": "/((?!functions/|api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/tasks", "schedule": "0 1 * * *" }
  ]
}
