{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/functions/v1/app/:path*",
      "destination": "https://mall.wyangming678-oss.deno.net/functions/v1/app/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
